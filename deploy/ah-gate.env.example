# /etc/ah-gate.env — configuration for ci/run-gate.sh on a VM/box.
# Install as root:root, mode 0600 (it holds a token).
#
#   sudo install -m 600 -o root -g root deploy/ah-gate.env.example /etc/ah-gate.env
#   sudoedit /etc/ah-gate.env

# Public repo, so an anonymous HTTPS clone is enough — no deploy key needed.
AH_GATE_REPO=https://github.com/dazeb/agent-harness-installer.git
AH_GATE_BRANCH=main

# Where the mirror clone and the last verdict live.
AH_GATE_SRC=/var/lib/ah-gate/src
AH_GATE_STATE=/var/lib/ah-gate/last-result
AH_GATE_LOG_DIR=/var/log/ah-gate

# Container image built from ci/Dockerfile (bash + shellcheck + curl + git).
AH_GATE_IMAGE=ah-gate:latest

# Token allowed to POST commit statuses on the repo (classic PAT, `repo`
# scope, or a fine-grained token with "Commit statuses: write").
# Without it the gate still runs and logs its verdict — only the badge is lost.
AH_GATE_TOKEN=
