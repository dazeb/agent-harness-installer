[Unit]
Description=agent-harness-installer CI gate (self-hosted stand-in for GitHub Actions)
Documentation=https://github.com/dazeb/agent-harness-installer
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/ah-gate.env
ExecStart=/usr/local/bin/ah-gate --once
TimeoutStartSec=900
Nice=10
# The gate only needs the repo mirror, docker and its own state dir.
ProtectSystem=strict
# /run is read-only under ProtectSystem=strict, and the docker client needs to
# talk to the daemon socket, so it is listed explicitly.
ReadWritePaths=/var/lib/ah-gate /var/log/ah-gate /run/docker.sock
PrivateTmp=yes
NoNewPrivileges=yes
